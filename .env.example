# Mẫu cấu hình. Chép thành .env.local (đã nằm trong .gitignore) rồi điền giá trị thật.

# --- Ứng dụng (xuống trình duyệt) -------------------------------------------------------------
# Bỏ trống cả hai: chạy thử bằng bản bộ nhớ (chỉ để dev, có sẵn PM chạy thử pm@vi-du.vn).
# Điền cả hai: dùng bản Supabase.
# CHỈ địa chỉ và khoá CÔNG KHAI (anon hoặc sb_publishable_...). Mọi biến VITE_* đều vào bản dựng,
# nên ứng dụng từ chối chạy nếu bất kỳ biến VITE_* nào chứa khoá service (service_role, sb_secret_...).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Bộ test hợp đồng trên Supabase thật (chỉ lệnh riêng, không xuống trình duyệt) -------------
# Đặt trong .env.test.local hoặc biến môi trường, rồi chạy:
#   npx vitest run --config vitest.supabase.config.ts
# Dùng project Supabase RIÊNG cho test (bộ test tạo nhiều tài khoản và đặt vai PM cho chúng).
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
# Tuỳ chọn: tên miền email test (mặc định example.com), thời hạn mã đặt lại tính bằng giây (mặc định 3600).
SUPABASE_TEST_EMAIL_DOMAIN=
SUPABASE_TEST_THOI_HAN_MA_GIAY=
